{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "FacturX case, schema_version 1",
  "description": "Descriptive schema for editors. scripts/check_cases.py is normative: it also derives each layer state, checks the evidence references and refuses claims no technical check can carry.",
  "type": "object",
  "required": ["schema_version", "id", "title", "kind", "class", "synthetic", "rights", "inputs", "evidence", "layers", "runs", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^(PR|EO)-[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["oracle", "product-run"]},
    "class": {"enum": ["valid", "error"]},
    "synthetic": {"const": true},
    "rights": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidence"}},
    "layers": {
      "type": "object",
      "required": ["packaging", "facturx_profile", "en16931", "fr_ctc", "pa_acceptance"],
      "properties": {
        "packaging": {"$ref": "#/$defs/layer"}, "facturx_profile": {"$ref": "#/$defs/layer"}, "en16931": {"$ref": "#/$defs/layer"},
        "fr_ctc": {"$ref": "#/$defs/layer"}, "pa_acceptance": {"$ref": "#/$defs/layer"}
      },
      "additionalProperties": false
    },
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source": {
      "oneOf": [
        {"type": "object", "required": ["type", "repo", "commit", "path"], "properties": {"type": {"const": "git"}, "repo": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string"}}},
        {"type": "object", "required": ["type", "url"], "properties": {"type": {"const": "url"}, "url": {"type": "string", "pattern": "^https://"}}}
      ]
    },
    "input": {"type": "object", "required": ["role", "format", "source", "sha256", "bytes"], "properties": {"role": {"type": "string"}, "format": {"enum": ["CII", "UBL", "PDF", "JSON"]}, "source": {"$ref": "#/$defs/source"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}},
    "evidence": {"type": "object", "required": ["what", "source", "sha256"], "properties": {"what": {"type": "string", "minLength": 1}, "source": {"$ref": "#/$defs/source"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}},
    "verdict": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"enum": ["pass", "fail"]}, "ids": {"type": "array", "items": {"type": "string"}}, "engine": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "layer": {"type": "object", "required": ["expectation", "observed", "state"], "properties": {"expectation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/verdict"}]}, "observed": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/verdict"}]}, "state": {"enum": ["confirmed", "mismatch", "not_run", "not_evaluated"]}, "reason": {"type": "string"}}},
    "run": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["oracle-replay", "api-call"]}, "engine": {"type": "string"}, "target": {"enum": ["staging", "production"]}, "when": {"type": "string"}, "api_build": {"type": "object"}, "request": {"type": "string"}, "replay": {"type": "string"}, "receipts": {"type": "array", "items": {"type": "string"}}}}
  }
}
